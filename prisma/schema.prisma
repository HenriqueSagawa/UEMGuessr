generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum SeasonStatus {
  PREVIEW
  ACTIVE
  ENDED
}

enum RankedDivision {
  BRONZE_III
  BRONZE_II
  BRONZE_I
  PRATA_III
  PRATA_II
  PRATA_I
  OURO_III
  OURO_II
  OURO_I
  PLATINA_III
  PLATINA_II
  PLATINA_I
  DIAMANTE_III
  DIAMANTE_II
  DIAMANTE_I
  MESTRE
}

enum RankedMatchStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum RankedQueueStatus {
  WAITING
  MATCHED
  CANCELLED
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  email    String  @unique
  password String?

  role UserRole @default(USER)

  provider       AuthProvider @default(LOCAL)
  googleId       String?      @unique
  avatarUrl      String?
  avatarPublicId String?

  displayName String?
  bio         String? @db.VarChar(280)
  themeColor  String? @db.VarChar(7)

  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  games                  Game[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetCodes     PasswordResetCode[]
  refreshTokens          RefreshToken[]
  locationsCreated       Location[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  rankedProfiles         RankedProfile[]
  rankedMatchesPlayer1   RankedMatch[]           @relation("RankedMatchPlayer1")
  rankedMatchesPlayer2   RankedMatch[]           @relation("RankedMatchPlayer2")
  rankedMatchesWon       RankedMatch[]           @relation("RankedMatchWinner")
  rankedQueueEntries     RankedQueueEntry[]
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Location {
  id String @id @default(cuid())

  name        String
  description String?

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  imageUrl      String?
  imagePublicId String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  rounds          Round[]
  dailyChallenges DailyChallenge[]
  rankedRounds    RankedRound[]
}

model Game {
  id String @id @default(cuid())

  userId String

  score Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  rounds Round[]
}

model Round {
  id String @id @default(cuid())

  gameId     String
  locationId String

  roundNumber Int

  guessLatitude  Decimal @db.Decimal(9, 6)
  guessLongitude Decimal @db.Decimal(9, 6)

  distanceMeters Decimal @db.Decimal(10, 2)

  score Int

  createdAt DateTime @default(now())

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@unique([gameId, locationId])
  @@unique([gameId, roundNumber])
}

model DailyChallenge {
  id               String   @id @default(cuid())
  challengeDate    DateTime @unique
  startsAt         DateTime
  endsAt           DateTime
  timeLimitSeconds Int      @default(60)
  locationId       String
  createdAt        DateTime @default(now())

  location Location                @relation(fields: [locationId], references: [id])
  attempts DailyChallengeAttempt[]

  @@index([startsAt])
  @@index([endsAt])
}

model DailyChallengeAttempt {
  id          String @id @default(cuid())
  challengeId String
  userId      String

  guessLatitude  Decimal? @db.Decimal(9, 6)
  guessLongitude Decimal? @db.Decimal(9, 6)
  distanceMeters Decimal? @db.Decimal(10, 2)
  score          Int?

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, score])
}

model Season {
  id        String       @id @default(cuid())
  name      String       @unique
  status    SeasonStatus @default(PREVIEW)
  startsAt  DateTime     @default(now())
  endsAt    DateTime?
  createdAt DateTime     @default(now())

  profiles     RankedProfile[]
  matches      RankedMatch[]
  queueEntries RankedQueueEntry[]

  @@index([status])
}

model RankedProfile {
  id         String         @id @default(cuid())
  userId     String
  seasonId   String
  rating     Int            @default(1200)
  division   RankedDivision @default(PRATA_III)
  wins       Int            @default(0)
  losses     Int            @default(0)
  bestRating Int            @default(1200)
  createdAt  DateTime       @default(now())
  updateAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId])
  @@index([seasonId, rating])
}

model RankedMatch {
  id                 String            @id @default(cuid())
  seasonId           String
  status             RankedMatchStatus @default(IN_PROGRESS)
  player1Id          String
  player2Id          String
  player1Health      Int               @default(5000)
  player2Health      Int               @default(5000)
  roundMultiplier    Decimal           @default(1) @db.Decimal(6, 2)
  currentRoundNumber Int               @default(0)
  winnerId           String?
  player1RatingDelta Int?
  player2RatingDelta Int?
  startedAt          DateTime          @default(now())
  finishedAt         DateTime?
  createdAt          DateTime          @default(now())

  season       Season             @relation(fields: [seasonId], references: [id])
  player1      User               @relation("RankedMatchPlayer1", fields: [player1Id], references: [id])
  player2      User               @relation("RankedMatchPlayer2", fields: [player2Id], references: [id])
  winner       User?              @relation("RankedMatchWinner", fields: [winnerId], references: [id])
  rounds       RankedRound[]
  queueEntries RankedQueueEntry[]

  @@index([seasonId])
  @@index([player1Id])
  @@index([player2Id])
  @@index([status])
}

model RankedRound {
  id          String    @id @default(cuid())
  matchId     String
  roundNumber Int
  locationId  String
  multiplier  Decimal   @db.Decimal(6, 2)
  startedAt   DateTime  @default(now())
  deadline    DateTime
  resolvedAt  DateTime?

  player1GuessLatitude  Decimal?  @db.Decimal(9, 6)
  player1GuessLongitude Decimal?  @db.Decimal(9, 6)
  player1Score          Int?
  player1DistanceMeters Decimal?  @db.Decimal(10, 2)
  player1AnsweredAt     DateTime?
  player1Damage         Int?

  player2GuessLatitude  Decimal?  @db.Decimal(9, 6)
  player2GuessLongitude Decimal?  @db.Decimal(9, 6)
  player2Score          Int?
  player2DistanceMeters Decimal?  @db.Decimal(10, 2)
  player2AnsweredAt     DateTime?
  player2Damage         Int?

  match    RankedMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  location Location    @relation(fields: [locationId], references: [id])

  @@unique([matchId, roundNumber])
  @@index([matchId, resolvedAt])
}

model RankedQueueEntry {
  id             String            @id @default(cuid())
  seasonId       String
  userId         String
  rating         Int
  status         RankedQueueStatus @default(WAITING)
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  matchedMatchId String?

  season Season       @relation(fields: [seasonId], references: [id])
  user   User         @relation(fields: [userId], references: [id])
  match  RankedMatch? @relation(fields: [matchedMatchId], references: [id])

  @@index([seasonId, status])
  @@index([userId])
  @@index([expiresAt])
}
